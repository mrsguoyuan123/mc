						"navigationBarTitleText": ""
					}
				},
				{
					"path": "pages/index/register",
					"style": {
						"navigationBarTitleText": ""
					}
				},
				{
					"path": "pages/index/home",
					"style": {
						"navigationBarTitleText": ""
					}
				},
				{
					"path": "pages/index/profile",
					"style": {
						"navigationBarTitleText": ""
					}
				},
				{
					"path": "pages/index/healthCenter",
